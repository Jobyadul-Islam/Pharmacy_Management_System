@model PharmacyManagement.Models.ViewModels.Stock.StockCreateEditViewModel

@{
    ViewData["Title"] = "Edit Stock";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Stock</h1>
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="EditStock">
                <input type="hidden" asp-for="StockId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="MedicineId" class="form-label">Medicine</label>
                    <select asp-for="MedicineId" asp-items="Model.Medicines" class="form-control"></select>
                    <span asp-validation-for="MedicineId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BatchNumber" class="form-label"></label>
                    <input asp-for="BatchNumber" class="form-control" maxlength="50" />
                    <span asp-validation-for="BatchNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" type="number" min="0" max="1000000" step="1" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PurchasePrice" class="form-label"></label>
                        <input asp-for="PurchasePrice" type="number" min="0.01" max="1000000" step="0.01" class="form-control" />
                        <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="SellingPrice" class="form-label"></label>
                        <input asp-for="SellingPrice" type="number" min="0.01" max="1000000" step="0.01" class="form-control" />
                        <span asp-validation-for="SellingPrice" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ManufacturingDate" class="form-label"></label>
                        <input asp-for="ManufacturingDate" class="form-control" max="@today" />
                        <span asp-validation-for="ManufacturingDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpiryDate" class="form-label"></label>
                        <input asp-for="ExpiryDate" class="form-control" />
                        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Update Stock</button>
                <a asp-action="Stocks" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
